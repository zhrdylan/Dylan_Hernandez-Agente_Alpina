APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Supabase: Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_ANSWER=openai/gpt-oss-120b
GROQ_MODEL_ROUTER=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b

# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_EMBED_DIM=1024

# Cloudflare R2 (se conecta en la fase de almacenamiento)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
