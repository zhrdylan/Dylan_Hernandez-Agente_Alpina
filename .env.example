APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Los orígenes CORS se expresan como una lista JSON. La interfaz del mismo origen no requiere CORS.
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=[]
TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
RATE_LIMIT_IP=300/minute
RATE_LIMIT_SESSION=120/minute
RATE_LIMIT_STORAGE_URI=memory://
# Uvicorn lee FORWARDED_ALLOW_IPS del entorno del proceso o de --forwarded-allow-ips.

# Supabase: Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=
# URL de conexión con rol DDL / postgres para aplicar migraciones (separación de rol migrador del rol web)
MIGRATION_DATABASE_URL=

# Cifrado simétrico AES-128-CBC + HMAC (Fernet de 32 bytes base64-urlsafe)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_ENCRYPTION_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_ANSWER=openai/gpt-oss-120b
GROQ_MODEL_ROUTER=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b

# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_EMBED_DIM=1024

# Cloudflare R2 (se conecta en la fase de almacenamiento)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
